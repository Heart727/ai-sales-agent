# 复制本文件为 .env，然后填入你的真实配置
# （Windows 下复制：选中本文件 → Ctrl+C → Ctrl+V → 重命名为 .env）

# DeepSeek API Key：在 https://platform.deepseek.com 注册后获取
DEEPSEEK_API_KEY=把你的-key-填在这里

# DeepSeek API 地址（OpenAI 兼容接口），一般不用改
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 模型名：deepseek-v4-pro（⚠️ 不要用 deepseek-chat，旧别名会被静默映射到弱模型）
DEEPSEEK_MODEL=deepseek-v4-pro

# 注册邀请码：在登录页注册账号时必须填这个码（防止陌生人注册账号看线索）
# 自己设一个别人猜不到的字符串，例如：my-company-888
AUTH_SIGNUP_CODE=请设置一个注册邀请码

# ===== 防刷限流参数（不配就用默认值，商用部署建议按业务量调）=====
# 每 IP 每分钟最多发几条消息
RATE_MSG_PER_MINUTE=8
# 每 IP 每天最多发几条消息（超了自动封禁 24 小时）
RATE_MSG_PER_DAY=100
# 每 IP 每天最多新建几个会话
RATE_SESSIONS_PER_DAY=20
# 每个会话最多几条消息
RATE_MSG_PER_SESSION=60
# 全局兜底：整个服务每天最多多少条消息
RATE_GLOBAL_MSG_PER_DAY=5000
# 触发日配额后封禁时长（小时）
BAN_HOURS=24
# 部署在 Nginx/云网关后面时设为 true
TRUST_PROXY=false
